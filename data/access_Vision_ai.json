    {
        "id": "fb11de363af92087",
        "type": "function",
        "z": "3ed7f94d76aa1659",
        "name": "Calculate Person-Time & Uptime + Availability",
        "func": "const device_id = msg.camera_id; \nif (!device_id) {\n    node.error(\"camera_id missing from msg! Cannot process data or availability.\");\n    return null; \n}\n\nvar startTime = flow.get(\"personTimeStartTime_\" + device_id);\nif (startTime === undefined) {\n    startTime = Date.now();\n    flow.set(\"personTimeStartTime_\" + device_id, startTime);\n    flow.set(\"personTimePreviousTimestamp_\" + device_id, startTime);\n    flow.set(\"personTimeTotalPersonSeconds_\" + device_id, 0);\n    node.warn(\"Initialized person-time tracking for \" + device_id + \". Start time: \" + startTime);\n}\n\nvar currentTime = Date.now();\nvar previousTimestamp = flow.get(\"personTimePreviousTimestamp_\" + device_id) || currentTime;\nvar totalPersonSeconds = flow.get(\"personTimeTotalPersonSeconds_\" + device_id) || 0;\n\nvar peopleCount = 0;\nif (msg.payload && Array.isArray(msg.payload)) {\n    peopleCount = msg.payload.length;\n}\n\nvar durationMs = currentTime - previousTimestamp;\nvar durationSeconds = durationMs / 1000.0;\n\nif (durationSeconds < 0) durationSeconds = 0;\n\nvar currentFramePersonSeconds = 0;\nvar isFirstFrame = (previousTimestamp === flow.get(\"personTimeStartTime_\" + device_id));\n\nif (durationSeconds > 0 || (isFirstFrame && durationSeconds === 0)) {\n    currentFramePersonSeconds = peopleCount * durationSeconds;\n    totalPersonSeconds += currentFramePersonSeconds;\n}\n\nflow.set(\"personTimeTotalPersonSeconds_\" + device_id, totalPersonSeconds);\nflow.set(\"personTimePreviousTimestamp_\" + device_id, currentTime);\n\nvar uptimeMs = currentTime - flow.get(\"personTimeStartTime_\" + device_id);\nvar uptimeHours = uptimeMs / 1000.0 /3600.0;\nuptimeHours = uptimeHours.toFixed(3); // 保留三位小数，结果为字符串\n\nconst dataMsg = {\n    topic: `vision_ai/${device_id}/state`,\n    payload: {\n        total_person_hours: (totalPersonSeconds / 3600.0).toFixed(3),\n        uptime_hours: uptimeHours,\n        current_people_count: peopleCount,\n    }\n};\n\nconst availabilityMsg = {\n    topic: `vision_ai/${device_id}/status`,\n    payload: \"online\",\n    retain: true\n};\n\nreturn [dataMsg, availabilityMsg];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1020,
        "y": 320,
        "wires": [
