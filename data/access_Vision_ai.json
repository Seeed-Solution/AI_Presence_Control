        "name": "Config: Person Hours Sensor",
        "func": "const device_id = msg.camera_id;\nif (!device_id) {\n    node.error(\"camera_id missing from msg for discovery!\");\n    return null;\n}\nmsg.topic = `homeassistant/sensor/${device_id}/total_person_hours/config`;\nmsg.payload = {\n  name: `Total Person Hours`,\n  state_topic: `vision_ai/${device_id}/state`,\n  availability_topic: `vision_ai/${device_id}/status`,\n  payload_available: \"online\",\n  payload_not_available: \"offline\",\n  value_template: \"{{ value_json.total_person_hours }}\",\n  unit_of_measurement: \"person_hours\",\n  icon: \"mdi:account-clock\",\n  unique_id: `${device_id}_total_person_hours`,\n  device: {\n    identifiers: [device_id],\n    name: `${device_id}`,\n    manufacturer: \"Seeed Studio\"\n  }\n};\nmsg.retain = true;\nreturn msg;",
