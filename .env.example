# 人脸识别门禁系统 - 分布式部署配置

# =================================
# Hailo设备配置 (FaceEmbed API)
# =================================
# Hailo设备IP地址 (运行FaceEmbed API的设备)
FACE_EMBED_API_HOST=192.168.10.179
FACE_EMBED_API_PORT=8000
# FaceEmbed API工作进程数 (支持并发)
FACE_EMBED_API_WORKERS=4

# =================================
# 向量数据库配置 (Qdrant)
# =================================
# Qdrant服务器配置
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=face_access_2025

# =================================
# MQTT服务器配置
# =================================
# MQTT Broker配置 (通常与Node-RED在同一台机器)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# =================================
# 算法参数配置
# =================================
# 人脸相似度阈值 (0-1, 越小越严格)
SIMILARITY_THRESHOLD=0.32
# 批量处理大小 (提高并发性能)
BATCH_SIZE=3
# 批量处理最大等待时间 (毫秒)
MAX_WAIT_TIME=100
# API调用超时时间 (毫秒)
API_TIMEOUT=5000

# =================================
# 设备与Collection映射
# =================================
# 为每个设备配置独立的人脸库
COLLECTION_grove_vision_ai_v2_001=office_entrance
COLLECTION_grove_vision_ai_v2_002=warehouse_door
COLLECTION_grove_vision_ai_v2_003=lab_access

# =================================
# 监控配置
# =================================
# Grafana管理员密码
GRAFANA_ADMIN_PASSWORD=admin123
# Prometheus数据保留时间
PROMETHEUS_RETENTION=200h

# =================================
# 部署模式配置
# =================================
# 部署模式: local-test | production | full
DEPLOY_MODE=production
# 启用的服务配置文件
COMPOSE_PROFILES=production

# =================================
# 安全配置
# =================================
# 是否启用TLS
ENABLE_TLS=false
# API密钥轮换间隔 (小时)
API_KEY_ROTATION_INTERVAL=24

# =================================
# 性能调优
# =================================
# 最大并发连接数
MAX_CONCURRENT_CONNECTIONS=100
# 内存缓存大小 (MB)
MEMORY_CACHE_SIZE=512
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
